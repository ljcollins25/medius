<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Medius\Medius.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\testmedia\**" />
    <None Remove="wwwroot\testmedia\**" />
  </ItemGroup>

  <Target Name="BuildBrowserPlayer"
          BeforeTargets="PrepareForBuild"
          Inputs="package.json;package-lock.json;player-src.js;build-player.mjs"
          Outputs="wwwroot\player.js;wwwroot\ffmpeg\worker.js;wwwroot\ffmpeg\ffmpeg-core.wasm">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="npm run build" />
  </Target>
</Project>
